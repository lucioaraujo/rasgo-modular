#!/usr/bin/env bash
# Rasgo Modular — captura o estado do app QUANDO ELE TRAVA.
#
# Rode isto ENQUANTO a janela está travada, antes de fechá-la: fechar o
# app apaga a única evidência que existe. Um travamento relatado de
# memória, depois que passou, não dá para investigar.
#
#   ./travou            captura única, para usar DURANTE um travamento
#   ./travou --perfil   monta a linha que perfila a thread da interface
#   ./travou --vigia    acompanha memória e CPU por 30 min, em segundo
#                       plano, e diz ao fim se a memória estabilizou
#
# Não mata nada e não mexe no áudio, exceto por uma pausa de instantes
# se o gdb conseguir anexar.
#
# O que sai daqui responde às perguntas que separam as causas possíveis:
#   - está GIRANDO (consumindo CPU) ou PARADO à espera de algo?
#   - se está girando, QUAL thread, e em que função?
#   - a memória está crescendo?
# Deadlock e laço infinito têm a mesma cara pra quem olha a janela, e
# tratamento completamente diferente.

set -uo pipefail
cd "$(dirname "$0")"

NOME="Rasgo Modular"
SAIDA="${TMPDIR:-/tmp}/rasgo-travou-$(date +%Y%m%d-%H%M%S).txt"

# ---- modo perfil -----------------------------------------------------
# A thread principal consome ~47% de um núcleo com o app apenas tocando,
# enquanto o MOTOR inteiro custa 14% (medido sem janela, com patches
# reais). Ou seja: o desenho custa mais que o som. Saber ONDE exige um
# perfil de verdade — e este sistema tem `perf_event_paranoid=4`, que o
# bloqueia sem privilégio. Em vez de falhar com um erro de permissão,
# imprime a linha pronta.
if [ "${1:-}" = "--perfil" ]; then
  P=$(pgrep -x "$NOME" | head -1 || true)
  if [ -z "$P" ]; then echo "Abra o app antes." >&2; exit 1; fi
  echo "Rode isto e me mande a saída (20 s de amostragem, não atrapalha o áudio):"
  echo
  echo "  sudo perf record -F 199 -g -p $P -o /tmp/rasgo-perf.data -- sleep 20 \\"
  echo "    && sudo perf report -i /tmp/rasgo-perf.data --stdio --no-children \\"
  echo "         --percent-limit 0.8 2>/dev/null | head -50"
  exit 0
fi

# ---- modo vigia ------------------------------------------------------
# Existe porque duas amostras não distinguem VAZAMENTO de AQUECIMENTO: um
# app recém-aberto cresce enquanto carrega fontes e caches sob demanda, e
# isso estabiliza. Chamar aquilo de vazamento a partir de duas leituras
# feitas aos 9 s e aos 48 s de vida seria concluir cedo demais — a curva
# ao longo de meia hora é que responde.
if [ "${1:-}" = "--vigia" ]; then
  P=$(pgrep -x "$NOME" | head -1 || true)
  if [ -z "$P" ]; then echo "Abra o app antes." >&2; exit 1; fi
  V="${TMPDIR:-/tmp}/rasgo-vigia-$(date +%Y%m%d-%H%M%S).tsv"
  echo "Acompanhando o pid $P por 30 min. Pode usar o app normalmente."
  echo "Tabela: $V"
  {
    printf "minuto	RSS_kB	delta_kB	%%CPU
"
    BASE=""
    for i in $(seq 0 180); do
      [ -r "/proc/$P/status" ] || break
      R=$(awk '/^VmRSS:/{print $2}' "/proc/$P/status")
      [ -z "$BASE" ] && BASE=$R
      C=$(ps -o %cpu= -p "$P" | tr -d ' ')
      printf "%.1f	%s	%+d	%s
" "$(echo "$i*10/60" | bc -l)" "$R" "$((R-BASE))" "$C"
      sleep 10
    done
  } | tee "$V"
  echo
  echo "--- veredito ---"
  # compara a primeira e a última TERÇA parte: se a memória ainda sobe no
  # fim no mesmo ritmo do começo, é vazamento; se achatou, foi aquecimento
  awk -F'	' 'NR>1{n++; r[n]=$2}
    END{
      if (n < 6) { print "amostras de menos para concluir"; exit }
      t=int(n/3);
      inicio=(r[t]-r[1])/t; fim=(r[n]-r[n-t])/t;
      printf "  crescimento no 1o terço: %+.1f kB por amostra
", inicio;
      printf "  crescimento no ultimo  : %+.1f kB por amostra
", fim;
      printf "  total: %+d kB
", r[n]-r[1];
      if (fim > inicio*0.5 && fim > 20)
        print "  => AINDA CRESCENDO no mesmo ritmo: vazamento provavel";
      else
        print "  => estabilizou: era aquecimento, nao vazamento";
    }' "$V"
  exit 0
fi

PIDS=$(pgrep -x "$NOME" || true)
if [ -z "$PIDS" ]; then
  echo "Não há nenhuma instância do Rasgo Modular aberta." >&2
  echo "Se ela acabou de ser fechada, a evidência foi embora com ela —" >&2
  echo "rode isto da próxima vez ANTES de fechar a janela." >&2
  exit 1
fi

exec > >(tee "$SAIDA") 2>&1

echo "=== Rasgo Modular — captura de travamento ==="
date -Is
echo

for P in $PIDS; do
  echo "--- processo $P ---"
  ps -o pid,stat,%cpu,%mem,etime,nlwp -p "$P" | sed 's/^/  /'
  echo
  grep -E "^(VmRSS|VmSize|Threads)" "/proc/$P/status" 2>/dev/null | sed 's/^/  /'
  echo

  # GIRANDO ou PARADO: a mesma janela congelada, causas opostas.
  # Duas amostras do tempo de CPU por thread, com 2 s entre elas.
  echo "  CPU por thread (2 s de amostragem):"
  declare -A ANTES
  for t in /proc/$P/task/*; do
    id=$(basename "$t")
    ANTES[$id]=$(awk '{print $14+$15}' "$t/stat" 2>/dev/null || echo 0)
  done
  sleep 2
  # o cabeçalho FORA do `sort`, senão ele é ordenado junto e vai parar
  # no fim da lista — foi o que aconteceu no primeiro teste
  printf "    %-10s %-16s %-6s %s\n" THREAD NOME "%CPU" ONDE
  {
    for t in /proc/$P/task/*; do
      id=$(basename "$t")
      [ -r "$t/stat" ] || continue
      depois=$(awk '{print $14+$15}' "$t/stat" 2>/dev/null || echo 0)
      delta=$(( depois - ${ANTES[$id]:-0} ))
      # ticks -> % de um núcleo em 2 s (100 ticks/s)
      pct=$(( delta * 100 / 200 ))
      nm=$(cat "$t/comm" 2>/dev/null)
      wc=$(cat "$t/wchan" 2>/dev/null)
      printf "    %-10s %-16s %-6s %s\n" "$id" "$nm" "$pct%" "${wc:-(rodando)}"
    done
  } | sort -k3 -rn -t' '
  echo

  # A pilha: é o que diz ONDE ele está preso. Sem isto, o resto é pista.
  echo "  Pilhas das threads:"
  if gdb -p "$P" -batch -ex "set pagination off" -ex "thread apply all bt 24" \
         2>/dev/null | grep -qE "^#|^Thread"; then
    gdb -p "$P" -batch -ex "set pagination off" \
        -ex "thread apply all bt 24" 2>/dev/null | sed 's/^/    /'
  else
    echo "    (não foi possível anexar — este sistema tem"
    echo "     kernel.yama.ptrace_scope=$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null))"
    echo
    echo "    Rode ESTA linha, com a janela ainda travada, e me mande a saída:"
    echo
    echo "      sudo gdb -p $P -batch -ex 'set pagination off' \\"
    echo "           -ex 'thread apply all bt 24'"
  fi
  echo
done

echo "=== fim ==="
echo
echo "Relatório salvo em: $SAIDA"
