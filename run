#!/usr/bin/env bash
# Rasgo Modular — abre o app JUCE (o front-end de produção).
#
# O painel X11 de teste continua no `.run_rasgo_modular.sh`; este script é
# do app multiplataforma, que é o artefato que vai na release.
#
# Uso:
#   ./run                  abre sorteando um patch novo
#   ./run 12345            abre reproduzindo o seed 12345
#   ./run --resume         retoma a sessão salva
#   ./run --rec-both       grava dos DOIS taps (pre-safety e post-safety)
#   ./run --build          recompila antes de abrir
#   ./run --fg             fica em primeiro plano (prende o terminal)
#   ./run 12345 --rec-both combina
#
# Por padrão o app abre SOLTO do terminal: o prompt volta na hora e a
# saída de diagnóstico vai pra um log. Use --fg quando quiser ver o
# stderr ao vivo.
#
# As opções são as variáveis de ambiente documentadas no INSTALL.md —
# aqui só embrulhadas em algo que se digita.

set -euo pipefail
cd "$(dirname "$0")"

BUILD_DIR=build
APP="$BUILD_DIR/apps/juce/RasgoModularApp_artefacts/Release/Rasgo Modular"
DO_BUILD=0
FOREGROUND=0
# Log POR INSTÂNCIA. Era um caminho fixo, e com duas janelas abertas as
# duas escreviam no mesmo arquivo: a segunda truncava o da primeira, e o
# que sobrava era um log impossível de ler — linhas de uma tomada
# aparecendo no log de outra sessão. Em 22 set. 2026 isso atrapalhou o
# diagnóstico de um travamento, que é justamente quando o log importa.
# O `$$` é o PID do script; o do app vai impresso ao lado.
LOG="${TMPDIR:-/tmp}/rasgo-modular-$$.log"

for arg in "$@"; do
  case "$arg" in
    --build)     DO_BUILD=1 ;;
    --fg)        FOREGROUND=1 ;;
    --resume)    export RASGO_RESUME=1 ;;
    --rec-both)  export RASGO_REC_TAP=both ;;
    --rec-pre)   export RASGO_REC_TAP=pre ;;
    # imprime o cabeçalho de comentário ATÉ a primeira linha de código —
    # faixa fixa de linhas desalinha assim que o comentário muda
    -h|--help)   awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    [0-9]*)      export RASGO_SEED="$arg" ;;
    *) echo "opção desconhecida: $arg (use --help)" >&2; exit 2 ;;
  esac
done

# Sem o JUCE apontado, o alvo `RasgoModularApp` NEM EXISTE, e o erro que
# aparece é "No rule to make target 'RasgoModularApp'" — que não diz nada
# sobre JUCE e manda a pessoa procurar no lugar errado. Pior: um `build/`
# configurado sem JUCE (fácil de criar rodando só `cmake -B build` para
# testar o motor) deixa o `./run --build` quebrado para sempre, porque o
# cache do CMake guarda a ausência.
#
# Então: procurar o JUCE sozinho, e reconfigurar quando o alvo faltar.
achar_juce() {
  # 1) o que a pessoa disser, 2) o cache de um build anterior,
  # 3) os lugares onde o JUCE vive nesta árvore.
  if [ -n "${RASGO_MODULAR_JUCE_PATH:-}" ]; then
    echo "$RASGO_MODULAR_JUCE_PATH"; return
  fi
  local doCache
  doCache=$(sed -n 's/^RASGO_MODULAR_JUCE_PATH:PATH=//p' \
            "$BUILD_DIR/CMakeCache.txt" 2>/dev/null | head -1)
  if [ -n "$doCache" ] && [ -d "$doCache" ]; then echo "$doCache"; return; fi
  local c
  for c in ../RASGO_SYNTH/JUCE-master ../../JUCE ../JUCE "$HOME/JUCE"; do
    [ -f "$c/CMakeLists.txt" ] && { (cd "$c" && pwd); return 0; }
  done
  # `return 0` mesmo sem achar, e isto NÃO é descuido: o script roda com
  # `set -e`, e numa atribuição `JUCE=$(achar_juce)` um status != 0 mata o
  # processo ali mesmo — sem executar a mensagem de erro logo abaixo, que
  # é justamente a que explicaria o que falta. Quem chama decide pelo
  # texto vazio.
  return 0
}

alvo_existe() {
  cmake --build "$BUILD_DIR" --target help 2>/dev/null \
    | grep -q "RasgoModularApp"
}

if [ ! -x "$APP" ] || [ "$DO_BUILD" = 1 ]; then
  if [ ! -d "$BUILD_DIR" ] || ! alvo_existe; then
    JUCE=$(achar_juce)
    if [ -z "$JUCE" ]; then
      echo "erro: não achei um checkout do JUCE." >&2
      echo "  O app não pode ser construído sem ele (o motor e os testes," >&2
      echo "  sim). Aponte-o e rode de novo:" >&2
      echo "    RASGO_MODULAR_JUCE_PATH=/caminho/para/JUCE ./run --build" >&2
      exit 1
    fi
    echo "-> configurando  (JUCE: $JUCE)"
    cmake -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release \
          -DRASGO_MODULAR_JUCE_PATH="$JUCE" >/dev/null
  fi
  echo "-> compilando"
  cmake --build "$BUILD_DIR" --target RasgoModularApp -j"$(nproc 2>/dev/null || echo 4)"
fi

if [ ! -x "$APP" ]; then
  echo "erro: não achei o app em:" >&2
  echo "  $APP" >&2
  echo "rode './run --build', ou configure com -DRASGO_MODULAR_JUCE_PATH=..." >&2
  exit 1
fi

# AVISA se já houver instância aberta. As opções (seed, resume, taps de
# gravação) são lidas do ambiente NO ARRANQUE: uma janela aberta antes
# não as tem, e as duas janelas ficam visualmente idênticas. Em 22 set.
# 2026 isto custou uma sessão de teste — `./run --rec-both` abriu uma
# segunda janela, a gravação foi feita na primeira, e saiu UM arquivo em
# vez de dois; o `--rec-both` parecia quebrado e estava certo.
# Só avisa, não mata: duas instâncias são legítimas (comparar dois seeds,
# por exemplo). Quem decide é quem está tocando.
ABERTAS=$(pgrep -c -x "Rasgo Modular" 2>/dev/null || echo 0)
if [ "$ABERTAS" -gt 0 ] 2>/dev/null; then
  echo "aviso: já há $ABERTAS instância(s) do Rasgo Modular aberta(s)." >&2
  echo "  As opções desta linha valem SÓ para a janela nova — a antiga" >&2
  echo "  não grava com os dois taps nem retoma sessão." >&2
  echo "  Para testar sem ambiguidade, feche as outras primeiro." >&2
fi

echo "-> abrindo${RASGO_SEED:+  seed=$RASGO_SEED}${RASGO_RESUME:+  resume}${RASGO_REC_TAP:+  tap=$RASGO_REC_TAP}"

if [ "$FOREGROUND" = 1 ]; then
  exec "$APP"
fi

# SOLTO do terminal. Com `exec` o shell era substituído pelo app e o
# terminal ficava preso até ele fechar — pra um app gráfico isso está
# errado: quem abriu quer o prompt de volta na hora. `setsid` o desprende
# da sessão, então fechar o terminal também não mata mais o app no meio de
# uma gravação.
setsid "$APP" >"$LOG" 2>&1 < /dev/null &
PID=$!
sleep 0.4
if kill -0 "$PID" 2>/dev/null; then
  echo "   pid $PID  ·  log: $LOG"
  echo "   diagnóstico ao vivo:  tail -f $LOG"
else
  echo "erro: o app não subiu. Últimas linhas do log:" >&2
  tail -n 15 "$LOG" >&2 || true
  exit 1
fi
